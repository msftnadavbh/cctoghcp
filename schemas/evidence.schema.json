{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"array",
  "items":{
    "type":"object",
    "required":["id"],
    "properties":{
      "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
      "preview":{"type":"boolean"},
      "status":{"enum":["pending","observed","not-run","passed","source-reviewed","help-observed","unit-tested","untested","fixture-only"]},
      "tier":{"enum":["offline","help-only","paid-integration"]},
      "argv":{"type":"array","minItems":1,"items":{"type":"string"}},
      "retrieved":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
       "kind":{"enum":["context7","official-docs","schema","release-api","upstream-example","local-observation","research-handoff"]},
      "url":{"type":"string","pattern":"^https://"},
      "note":{"type":"string"},
      "claim":{"type":"string","minLength":1},
      "limitations":{"type":"string","minLength":1},
      "fixture":{"type":"string"},
      "expected":{"type":"string"},
       "evidence":{"type":["string","null"]},
       "source_review":{"type":"boolean"},
       "syntax_checked":{"type":"boolean"},
       "configuration_parsed":{"type":"boolean"},
       "runtime_tested":{"type":"boolean"},
       "authenticated_integration_tested":{"type":"boolean"},
       "unavailable_in_test_environment":{"type":"boolean"},
       "surface":{"type":"string"},
       "hosting":{"type":"string"},
       "availability":{"type":"string"},
       "verified_as_of":{"type":"string"},
       "version":{"type":"string"},
       "confidence":{"type":"string"},
       "used_by":{"type":"array","items":{"type":"string"}},
       "purpose":{"type":"string"},
       "risk":{"type":"string"},
       "credentials":{"type":"string"},
       "output_type":{"type":"string"},
       "method":{"type":"string"},
       "result":{"type":"string"}
    },
    "additionalProperties":false
  }
}
